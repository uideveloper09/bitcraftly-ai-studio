# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://bitcraftly:bitcraftly@localhost:5432/bitcraftly_ai_studio?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# AI Providers (mock for Phase 1)
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_VOICE_PROVIDER=mock
AI_VIDEO_PROVIDER=mock

# Logging
LOG_LEVEL=info
